# engine
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
OPENAI_API_KEY=
OPENAI_MODEL=
FRED_API_KEY=
# check against this date instead of today (e.g. 2023-12-04 for the Hertz case study)
DRIFT_AS_OF=

# web: 1 = read schema/fixtures, 0 = call the engine
VITE_USE_FIXTURE=1
VITE_ENGINE_URL=http://localhost:8000

# Clerk (publishable key is public; never put the secret key in VITE_ vars)
VITE_CLERK_PUBLISHABLE_KEY=

# Web demo. Unset (or anything but 0) disables Clerk and the database. 0 restores both.
# The Base44 workbooks function reads the same switch from a DEMO_MODE secret.
VITE_DEMO_MODE=
